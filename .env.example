# ─────────────────────────────────────────────────────────────────────────────
# CX Agent Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CX Agent Hub
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (or  python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cxhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cxhub
DATABASE_URL=postgresql+asyncpg://cxhub:CHANGE_ME_STRONG_PASSWORD@db:5432/cxhub

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Phase 2: Queue (ARQ / Redis) ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379
AI_QUEUE_ENABLED=true
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_JOB_TIMEOUT_SECONDS=300

# ── Phase 3: Knowledge Base / RAG ─────────────────────────────────────────────
# Path inside the container (mapped to 'knowledge_data' Docker volume)
KNOWLEDGE_STORAGE_PATH=/data/knowledge
# Embedding provider: "mock" (no API key) or "openai" (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=mock
# OpenAI embedding model (used only when EMBEDDING_PROVIDER=openai)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensions must match the model (1536 for text-embedding-3-small / ada-002)
EMBEDDING_DIMENSIONS=1536
# Text chunking — tweak to balance context richness vs. embedding cost
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=100
