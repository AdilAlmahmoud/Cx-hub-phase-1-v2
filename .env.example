# ─────────────────────────────────────────────────────────────────────────────
# CX Agent Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CX Agent Hub
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (or  python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cxhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cxhub
DATABASE_URL=postgresql+asyncpg://cxhub:CHANGE_ME_STRONG_PASSWORD@db:5432/cxhub

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
