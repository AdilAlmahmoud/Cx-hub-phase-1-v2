# ─────────────────────────────────────────────────────────────────────────────
# CX Agent Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CX Agent Hub
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (or  python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cxhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cxhub
DATABASE_URL=postgresql+asyncpg://cxhub:CHANGE_ME_STRONG_PASSWORD@db:5432/cxhub

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Phase 2: Queue (ARQ / Redis) ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379
AI_QUEUE_ENABLED=true
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_JOB_TIMEOUT_SECONDS=300

# ── Phase 3: Knowledge Base / RAG ─────────────────────────────────────────────
KNOWLEDGE_STORAGE_PATH=/data/knowledge
EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=100

# ── Phase 4: Outbound Messaging ────────────────────────────────────────────────
# Outbound delivery provider: "mock" (logs only, no real delivery) or future real providers
# Set to "mock" for local development; configure per-channel providers for production
OUTBOUND_PROVIDER=mock
# Maximum delivery attempts per message before marking permanently failed
OUTBOUND_MAX_ATTEMPTS=3
